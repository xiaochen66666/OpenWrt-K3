################################################################################
#     ImmortalWrt 极致精简配置 - Phicomm K3 (仅路由 + HomeProxy)
#                   内核版本: 6.6 | 架构: arm_cortex-a9
################################################################################

# ==============================================================================
# 一、平台与架构
# ==============================================================================

CONFIG_TARGET_bcm53xx=y
CONFIG_TARGET_bcm53xx_generic=y
CONFIG_TARGET_bcm53xx_generic_DEVICE_phicomm_k3=y
CONFIG_arm=y
CONFIG_arm_v7=y
CONFIG_ARCH="arm"
CONFIG_CPU_TYPE="cortex-a9"
CONFIG_TARGET_ARCH_PACKAGES="arm_cortex-a9"
CONFIG_SOFT_FLOAT=y
CONFIG_TARGET_SUFFIX="muslgnueabi"

# ==============================================================================
# 二、内核版本与构建
# ==============================================================================

CONFIG_LINUX_6_6=y
CONFIG_MODULES=y
CONFIG_HAVE_DOT_CONFIG=y
CONFIG_HOST_OS_LINUX=y
CONFIG_JSON_OVERVIEW_IMAGE_INFO=y
CONFIG_SIGNED_PACKAGES=y
CONFIG_SIGNATURE_CHECK=y
CONFIG_DOWNLOAD_CHECK_CERTIFICATE=y
CONFIG_AUTOREBUILD=y
CONFIG_IPV6=y

# ==============================================================================
# 三、编译优化
# ==============================================================================

CONFIG_DEFAULT_TARGET_OPTIMIZATION="-Os -pipe"
CONFIG_TARGET_OPTIMIZATION="-Os -pipe"
CONFIG_EXTRA_OPTIMIZATION="-fno-caller-saves -fno-plt"
CONFIG_KERNEL_CFLAGS="-falign-functions=32"
CONFIG_MOLD=y

# ==============================================================================
# 四、安全加固
# ==============================================================================

CONFIG_PKG_CHECK_FORMAT_SECURITY=y
CONFIG_PKG_ASLR_PIE_REGULAR=y
CONFIG_PKG_CC_STACKPROTECTOR_REGULAR=y
CONFIG_KERNEL_CC_STACKPROTECTOR_REGULAR=y
CONFIG_KERNEL_STACKPROTECTOR=y
CONFIG_PKG_FORTIFY_SOURCE_1=y
CONFIG_PKG_RELRO_FULL=y
CONFIG_USE_SECCOMP=y
CONFIG_SHADOW_PASSWORDS=y
CONFIG_SSP_SUPPORT=y

# ==============================================================================
# 五、工具链
# ==============================================================================

CONFIG_USE_MUSL=y
CONFIG_MUSL_DISABLE_CRYPT_SIZE_HACK=y
CONFIG_BINUTILS_VERSION_2_42=y
CONFIG_BINUTILS_VERSION="2.42"
CONFIG_GCC_VERSION="13.3.0"
CONFIG_GCC_USE_DEFAULT_VERSION=y
CONFIG_LIBC="musl"
CONFIG_GDB=y
CONFIG_HAS_BPF_TOOLCHAIN=y

# ==============================================================================
# 六、软件包剥离
# ==============================================================================

CONFIG_USE_SSTRIP=y
CONFIG_SSTRIP_DISCARD_TRAILING_ZEROES=y

# ==============================================================================
# 七、目标镜像
# ==============================================================================

CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_SQUASHFS_BLOCK_SIZE=1024
CONFIG_TARGET_UBIFS_FREE_SPACE_FIXUP=y
CONFIG_NAND_SUPPORT=y
CONFIG_USES_SQUASHFS=y
CONFIG_USES_DEVICETREE=y

# ==============================================================================
# 八、启动参数
# ==============================================================================

CONFIG_TARGET_PREINIT_SUPPRESS_STDERR=y
CONFIG_TARGET_PREINIT_TIMEOUT=4
CONFIG_TARGET_PREINIT_IP="192.168.1.1"
CONFIG_TARGET_PREINIT_NETMASK="255.255.255.0"
CONFIG_TARGET_PREINIT_BROADCAST="192.168.1.255"
CONFIG_TARGET_INIT_PATH="/usr/sbin:/usr/bin:/sbin:/bin"
CONFIG_TARGET_INIT_CMD="/sbin/init"
CONFIG_TARGET_INIT_SUPPRESS_STDERR=y

# ==============================================================================
# 九、基础硬件支持（移除了 USB 存储相关）
# ==============================================================================

CONFIG_AUDIO_SUPPORT=y
CONFIG_GPIO_SUPPORT=y
CONFIG_PCI_SUPPORT=y
CONFIG_PCIE_SUPPORT=y
CONFIG_PWM_SUPPORT=y
CONFIG_USB_SUPPORT=y

# --- 仅保留 USB 核心（网卡/手机热点可能用到），移除存储相关 ---
CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb-ehci=y
CONFIG_PACKAGE_kmod-usb-ohci=y
CONFIG_PACKAGE_kmod-usb-xhci-hcd=y
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-ledtrig-usbport=y
# CONFIG_PACKAGE_kmod-usb-storage     已移除
# CONFIG_PACKAGE_kmod-usb-storage-extras  已移除
# CONFIG_PACKAGE_kmod-usb-storage-uas     已移除
CONFIG_PACKAGE_kmod-usb-bcma=y
CONFIG_PACKAGE_kmod-phy-bcm-ns-usb2=y
CONFIG_PACKAGE_kmod-phy-bcm-ns-usb3=y

# ==============================================================================
# 十、文件系统（仅保留 squashfs 原生，移除 ext4/exfat/ntfs/vfat）
# ==============================================================================

# CONFIG_PACKAGE_kmod-fs-ext4    已移除
# CONFIG_PACKAGE_kmod-fs-exfat   已移除
# CONFIG_PACKAGE_kmod-fs-ntfs3   已移除
# CONFIG_PACKAGE_kmod-fs-vfat    已移除
CONFIG_PACKAGE_kmod-nls-base=y
CONFIG_PACKAGE_kmod-nls-cp437=y
CONFIG_PACKAGE_kmod-nls-iso8859-1=y
CONFIG_PACKAGE_kmod-nls-utf8=y
# CONFIG_PACKAGE_e2fsprogs       已移除
# CONFIG_PACKAGE_lsblk           已移除
# CONFIG_PACKAGE_ntfs3-mount     已移除
CONFIG_PACKAGE_ubi-utils=y
# CONFIG_PACKAGE_hd-idle         已移除

# ==============================================================================
# 十一、无线（已添加 SDIO 支持修复）
# ==============================================================================

CONFIG_PACKAGE_kmod-cfg80211=y
CONFIG_PACKAGE_kmod-brcmutil=y
CONFIG_PACKAGE_kmod-brcmfmac=y
CONFIG_BRCMFMAC_SDIO=y           # 【修复】K3 无线必须
CONFIG_BRCMFMAC_USB=y
CONFIG_BRCMFMAC_PCIE=y
CONFIG_PACKAGE_kmod-brcmfmac-sdio=y  # 【修复】K3 无线必须
CONFIG_PACKAGE_brcmfmac-firmware-4366c0-pcie-k3=y
CONFIG_PACKAGE_brcmfmac-firmware-usb=y
CONFIG_PACKAGE_wireless-regdb=y
CONFIG_PACKAGE_iw=y
CONFIG_PACKAGE_iwinfo=y
CONFIG_PACKAGE_libiwinfo=y
CONFIG_PACKAGE_libiwinfo-data=y
CONFIG_PACKAGE_wifi-scripts=y
CONFIG_PACKAGE_wpad-openssl=y
CONFIG_PACKAGE_hostapd-common=y
CONFIG_WPA_MSG_MIN_PRIORITY=3
CONFIG_DRIVER_11AC_SUPPORT=y
CONFIG_WPA_MBO_SUPPORT=y

# ==============================================================================
# 十二、网络与防火墙 (Netfilter) - 完整保留
# ==============================================================================

# --- 核心 ---
CONFIG_PACKAGE_kmod-nfnetlink=y
CONFIG_PACKAGE_kmod-nf-conntrack=y
CONFIG_PACKAGE_kmod-nf-conntrack-netlink=y
CONFIG_PACKAGE_kmod-nf-conntrack6=y
CONFIG_PACKAGE_kmod-nf-flow=y
CONFIG_PACKAGE_kmod-nf-ipt=y
